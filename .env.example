# Скопируйте файл в .env и заполните значения. Поиск использует только живые источники.

# Необязательная защита публичного Gradio-интерфейса
APP_USERNAME=
APP_PASSWORD=
GRADIO_SHARE=false

# LLM для извлечения данных со страниц (OpenAI-совместимый API)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_SUPPLIERS=6
LLM_MAX_PAGES_PER_SUPPLIER=2
LLM_MAX_CHARS_PER_SUPPLIER=18000
LLM_MAX_CONCURRENT_REQUESTS=2

TWO_GIS_ENABLED=false
TWO_GIS_API_KEY=
# Обычно менять не нужно; отдельное значение удобно для тестового API-шлюза.
TWO_GIS_BASE_URL=https://catalog.api.2gis.com/3.0
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
BRAVE_SEARCH_API_KEY=

# Публичный API «Госзатраты» по данным ЕИС (без ключа)
CLEAR_SPENDING_ENABLED=true
CLEAR_SPENDING_BASE_URL=https://openapi.clearspending.ru/restapi/v3/contracts/search/
CLEAR_SPENDING_TIMEOUT_SECONDS=12
CLEAR_SPENDING_MAX_CONTRACTS=30
CLEAR_SPENDING_MAX_SUPPLIERS=12

# B2B-каталог товарных карточек российских производителей (без ключа)
PRODUCTCENTER_ENABLED=true

# Прямой RSS ЕИС нестабилен; выключен по умолчанию, «Госзатраты» остаются включены.
EIS_ENABLED=false
EIS_BASE_URL=https://zakupki.gov.ru
EIS_TIMEOUT_SECONDS=8
EIS_DEADLINE_SECONDS=12
EIS_MAX_QUERIES=6
EIS_MAX_CONTRACTS=8
# Официальный корневой сертификат Минцифры уже включён в проект.
EIS_CA_BUNDLE=certs/Russian_Trusted_Root_CA.pem

LIVE_SEARCH_DEADLINE_SECONDS=45
PAGE_TIMEOUT_SECONDS=8
MAX_LIVE_DOMAINS=12
MAX_RESPONSE_BYTES=2000000
DUCKDUCKGO_FALLBACK_ENABLED=true

# Загрузка страниц и кэш
CACHE_TTL_HOURS=168
MAX_PAGES_PER_DOMAIN=5
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
